# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバだけで使う（アカウント作成・期限つきのファイルURL・Actifyくんの返事の書き込み）。ブラウザに出さない
SUPABASE_SERVICE_ROLE_KEY=

# 招待・パスワードのメールのリンクの戻り先（末尾の / なし）。Supabase の Site URL と同じにする
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Actifyくんの返事と目次の写真の読み取り（未設定なら決まった文の返事。読み取りは手入力）
ANTHROPIC_API_KEY=
# モデル（既定 claude-opus-5-5）
ACTIFY_CHAT_MODEL=
ACTIFY_OCR_MODEL=
# AI の原価を円にするときの為替（既定 150）
USD_JPY=150
# ファイルの期限つきURLの有効時間（秒、既定 300）
SIGNED_URL_SECONDS=300
# 上限の確かめに使う「1回の見込みの原価（円）」。塾ごとの月の予算・1人1日の回数は schools テーブル（既定 5,000円・30回）
AI_CHAT_ESTIMATE_JPY=30
AI_OCR_ESTIMATE_JPY=40

# ---- 保護者への LINE・端末への通知・定期処理・塾の契約（無ければ、その機能だけ止まる） ----
# 塾ごとの LINE の鍵を DB に置くときの暗号の鍵（openssl rand -base64 32）。一度決めたら変えない（変えると保存済みの鍵が読めなくなる）
SECRETS_KEY=
# 定期処理（/api/cron/*）の合言葉。Vercel の Cron は Authorization: Bearer <この値> を付けて呼ぶ
CRON_SECRET=
# Web Push の鍵（npx web-push generate-vapid-keys）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@actify.jp
# Stripe（塾が Actify に払う月額）。価格は「生徒1人あたりの月額」で作る
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# 初めて契約する塾の無料期間（日。既定 30、0 で無し）
STRIPE_TRIAL_DAYS=30
