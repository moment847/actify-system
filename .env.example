# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバだけで使う（アカウント作成・期限つきのファイルURL・Actifyくんの返事の書き込み）。ブラウザに出さない
SUPABASE_SERVICE_ROLE_KEY=

# Actifyくんの返事と目次の写真の読み取り（未設定なら決まった文の返事。読み取りは手入力）
ANTHROPIC_API_KEY=
# モデル（既定 claude-opus-5-5）
ACTIFY_CHAT_MODEL=
ACTIFY_OCR_MODEL=
# AI の原価を円にするときの為替（既定 150）
USD_JPY=150
# ファイルの期限つきURLの有効時間（秒、既定 300）
SIGNED_URL_SECONDS=300
